function factorial(n) ->
  remember result = 1
  when n > 1
    remember result = n * factorial(n - 1)
  end
  return result
end

function pow(n) ->
    return n * n
end

function test1(n) ->
    print "test 1 ="
    return ++n
end

function test2(n) ->
    print "test 2 = "
    return n++
end

function test3() -> factorial(5) end

print test1(1)

print test2(1)

print test3()
